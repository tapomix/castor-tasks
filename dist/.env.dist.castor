# sample file to override castor tasks configuration
# copy this to .castor/.env.castor

# specific castor env
# APP_CODE_PATH=code # . (if no sub-directory)
APP_FRAMEWORK=vanilla # vanilla | laravel | symfony | ...

# APP_SERVICE_DB=db
# APP_SERVICE_NODE=node
# APP_SERVICE_PHP=php

# CASTOR_DEFAULT_BROWSER=firefox

# git remote used by infra:sync and infra:status
# INFRA_REMOTE=infra

# app variables, read from the app env file by convention:
# APP_ENV, CONTAINER_NAME, DB_NAME, DB_USER, TRAEFIK_HOST
# override only when the app env uses other names, e.g.:
# APP_DB_NAME=${DB_DATABASE}
